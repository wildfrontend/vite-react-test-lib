{
  "trailingComma": "es5",
  "tabWidth": 2,
  "semi": true,
  "singleQuote": true,
  "plugins": [
    "@trivago/prettier-plugin-sort-imports",
    "prettier-plugin-tailwindcss"
  ],
  "importOrder": [
    "<THIRD_PARTY_MODULES>",
    "^apis/(.*)$",
    "^assets/(.*)$",
    "^components/(.*)$",
    "^constants(.*)$",
    "^contexts/(.*)$",
    "^hooks/(.*)$",
    "^pages/(.*)$",
    "^routes/(.*)$",
    "^types/(.*)$",
    "^utils/(.*)$",
    "^[./]"
  ],
  "importOrderSortSpecifiers": true
}